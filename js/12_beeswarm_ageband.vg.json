{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 460,
  "data": {
    "url": "data/volunteer_sa4_ageband_2021.csv"
  },
  "transform": [
    {
      "filter": "datum.region_type !== 'Other Territories'"
    }
  ],
  "encoding": {
    "y": {
      "field": "age_band",
      "type": "nominal",
      "title": null,
      "sort": [
        "15\u201324",
        "25\u201344",
        "45\u201364",
        "65+"
      ],
      "axis": {
        "labelFontSize": 15,
        "labelFontWeight": 600,
        "labelColor": "#DCEBE0",
        "domain": false,
        "ticks": false,
        "labelPadding": 12
      }
    },
    "x": {
      "field": "rate_respondents",
      "type": "quantitative",
      "title": "% of people who answered the question and volunteered",
      "scale": {
        "domain": [
          3,
          36
        ]
      },
      "axis": {
        "labelExpr": "datum.value + '%'",
        "values": [
          5,
          10,
          15,
          20,
          25,
          30,
          35
        ],
        "labelFontSize": 13,
        "titleFontSize": 13,
        "grid": true
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "circle",
        "size": 95,
        "stroke": "#14383A",
        "strokeWidth": 1
      },
      "encoding": {
        "yOffset": {
          "field": "sa4_code",
          "type": "nominal",
          "scale": {
            "band": 0.9
          },
          "legend": null
        },
        "color": {
          "field": "region_type",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Greater capital city",
              "Rest of state"
            ],
            "range": [
              "#D99A2B",
              "#A5D8BC"
            ]
          }
        },
        "opacity": {
          "condition": {
            "param": "regionPick",
            "value": 0.8
          },
          "value": 0.07
        },
        "tooltip": [
          {
            "field": "sa4_name",
            "type": "nominal",
            "title": "Region"
          },
          {
            "field": "region_type",
            "type": "nominal",
            "title": "Type"
          },
          {
            "field": "age_band",
            "type": "nominal",
            "title": "Age"
          },
          {
            "field": "rate_respondents",
            "type": "quantitative",
            "title": "Volunteering rate (%)",
            "format": ".1f"
          }
        ]
      },
      "params": [
        {
          "name": "regionPick",
          "select": {
            "type": "point",
            "fields": [
              "region_type"
            ]
          },
          "bind": "legend"
        }
      ]
    },
    {
      "transform": [
        {
          "filter": {
            "param": "regionPick"
          }
        }
      ],
      "mark": {
        "type": "tick",
        "thickness": 2,
        "size": 104,
        "color": "#F3EFE3",
        "opacity": 0.75
      },
      "encoding": {
        "x": {
          "field": "rate_respondents",
          "type": "quantitative",
          "aggregate": "median"
        },
        "tooltip": [
          {
            "field": "age_band",
            "type": "nominal",
            "title": "Age"
          },
          {
            "field": "rate_respondents",
            "type": "quantitative",
            "aggregate": "median",
            "title": "Median region (%)",
            "format": ".1f"
          },
          {
            "field": "sa4_name",
            "aggregate": "count",
            "type": "quantitative",
            "title": "Regions included"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.age_band === '15\u201324'"
        },
        {
          "filter": {
            "param": "regionPick"
          }
        }
      ],
      "mark": {
        "type": "text",
        "text": "median",
        "align": "center",
        "baseline": "bottom",
        "dy": -56,
        "fontSize": 11.5,
        "fontWeight": 600,
        "color": "#F3EFE3",
        "opacity": 0.8
      },
      "encoding": {
        "x": {
          "field": "rate_respondents",
          "type": "quantitative",
          "aggregate": "median"
        }
      }
    }
  ]
}