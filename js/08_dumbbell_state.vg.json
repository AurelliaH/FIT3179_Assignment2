{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 380,
  "data": {
    "url": "data/volunteer_state_compare_2016_2021.csv"
  },
  "encoding": {
    "y": {
      "field": "state_abbr",
      "type": "nominal",
      "title": null,
      "sort": [
        "ACT",
        "Tas",
        "SA",
        "WA",
        "NT",
        "Qld",
        "Vic",
        "NSW"
      ],
      "axis": {
        "labelFontSize": 12,
        "labelFontWeight": 500,
        "domain": false,
        "ticks": false
      }
    }
  },
  "layer": [
    {
      "transform": [
        {
          "pivot": "year",
          "value": "rate_pop15plus",
          "groupby": [
            "state",
            "state_abbr"
          ]
        }
      ],
      "mark": {
        "type": "rule",
        "strokeWidth": 2.5,
        "color": "#3D6460"
      },
      "encoding": {
        "x": {
          "field": "2016",
          "type": "quantitative",
          "title": "% of all people aged 15+ who volunteered",
          "scale": {
            "domain": [
              12,
              25
            ]
          },
          "axis": {
            "format": ".0f",
            "tickCount": 6,
            "grid": true
          }
        },
        "x2": {
          "field": "2021"
        }
      }
    },
    {
      "transform": [
        {
          "calculate": "toString(datum.year)",
          "as": "Census"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 150,
        "opacity": 1,
        "stroke": "#14383A",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "rate_pop15plus",
          "type": "quantitative"
        },
        "color": {
          "field": "Census",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "2016",
              "2021"
            ],
            "range": [
              "#A5D8BC",
              "#D99A2B"
            ]
          }
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "Census",
            "type": "nominal",
            "title": "Census"
          },
          {
            "field": "rate_pop15plus",
            "type": "quantitative",
            "title": "Volunteering rate (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "pivot": "year",
          "value": "rate_pop15plus",
          "groupby": [
            "state",
            "state_abbr"
          ]
        },
        {
          "calculate": "datum['2021'] - datum['2016']",
          "as": "change"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 11,
        "fontSize": 11,
        "fontWeight": 500,
        "color": "#C2DAC9"
      },
      "encoding": {
        "x": {
          "field": "2016",
          "type": "quantitative"
        },
        "text": {
          "field": "change",
          "type": "quantitative",
          "format": "+.1f"
        }
      }
    }
  ],
  "transform": [
    {
      "filter": "datum.state_abbr !== 'OT'"
    }
  ]
}