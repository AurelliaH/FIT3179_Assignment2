{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 380,
  "data": {
    "url": "data/volunteer_sa4_2021.csv"
  },
  "transform": [
    {
      "filter": "datum.sa4_code != 901"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "circle",
        "size": 150,
        "stroke": "#1E5551",
        "strokeWidth": 1.1
      },
      "encoding": {
        "x": {
          "field": "population_15plus",
          "type": "quantitative",
          "title": "People aged 15 and over in the region",
          "scale": {
            "type": "linear",
            "domain": [
              0,
              700000
            ],
            "nice": false
          },
          "axis": {
            "format": "~s",
            "grid": true,
            "values": [
              0,
              100000,
              200000,
              300000,
              400000,
              500000,
              600000,
              700000
            ],
            "labelExpr": "datum.value === 0 ? '0' : format(datum.value, '~s')"
          }
        },
        "y": {
          "field": "rate_pop15plus",
          "type": "quantitative",
          "title": "% of people aged 15+ who volunteered",
          "scale": {
            "domain": [
              4,
              30
            ]
          },
          "axis": {
            "format": ".0f",
            "grid": true
          }
        },
        "color": {
          "field": "region_type",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Greater capital city",
              "Rest of state"
            ],
            "range": [
              "#D99A2B",
              "#A5D8BC"
            ]
          },
          "legend": {
            "labelLimit": 300
          }
        },
        "opacity": {
          "condition": {
            "param": "regionPick",
            "value": 0.78
          },
          "value": 0.08
        },
        "tooltip": [
          {
            "field": "sa4_name",
            "type": "nominal",
            "title": "Region"
          },
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "region_type",
            "type": "nominal",
            "title": "Type"
          },
          {
            "field": "rate_pop15plus",
            "type": "quantitative",
            "title": "Volunteering rate (%)",
            "format": ".1f"
          },
          {
            "field": "volunteers",
            "type": "quantitative",
            "title": "Volunteers",
            "format": ","
          },
          {
            "field": "population_15plus",
            "type": "quantitative",
            "title": "Adults 15+",
            "format": ","
          }
        ]
      },
      "params": [
        {
          "name": "regionPick",
          "select": {
            "type": "point",
            "fields": [
              "region_type"
            ]
          },
          "bind": "legend"
        }
      ]
    },
    {
      "data": {
        "values": [
          {
            "y": 14.13
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#7E9E93",
        "strokeDash": [
          4,
          4
        ],
        "strokeWidth": 1
      },
      "encoding": {
        "y": {
          "field": "y",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 690000,
            "y": 14.13,
            "t": "national average 14.1%"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "dy": -9,
        "fontSize": 11,
        "color": "#7E9E93",
        "dx": -4
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        "text": {
          "field": "t",
          "type": "nominal"
        }
      }
    }
  ]
}