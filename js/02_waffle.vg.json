{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "sequence": {
      "start": 0,
      "stop": 200,
      "as": "i"
    }
  },
  "transform": [
    {
      "calculate": "datum.i < 100 ? '2016: 19 in 100' : '2021: 14 in 100'",
      "as": "census"
    },
    {
      "calculate": "datum.i % 100",
      "as": "n"
    },
    {
      "calculate": "floor(datum.n / 10)",
      "as": "row"
    },
    {
      "calculate": "datum.n % 10",
      "as": "col"
    },
    {
      "calculate": "datum.i < 100 ? 19 : 14",
      "as": "threshold"
    },
    {
      "calculate": "datum.n < datum.threshold ? 'Volunteered' : 'Did not volunteer'",
      "as": "status"
    }
  ],
  "columns": 2,
  "spacing": 42,
  "facet": {
    "field": "census",
    "type": "nominal",
    "title": null,
    "header": {
      "labelFontSize": 16,
      "labelFontWeight": 600,
      "labelColor": "#DCEBE0",
      "labelAnchor": "start",
      "labelPadding": 8
    }
  },
  "spec": {
    "width": 265,
    "height": 265,
    "mark": {
      "type": "square",
      "size": 460,
      "cornerRadius": 2.5,
      "opacity": 1
    },
    "encoding": {
      "x": {
        "field": "col",
        "type": "ordinal",
        "axis": null
      },
      "y": {
        "field": "row",
        "type": "ordinal",
        "axis": null
      },
      "color": {
        "field": "status",
        "type": "nominal",
        "title": null,
        "scale": {
          "domain": [
            "Volunteered",
            "Did not volunteer"
          ],
          "range": [
            "#6FB8AE",
            "#305C59"
          ]
        }
      },
      "tooltip": [
        {
          "field": "census",
          "type": "nominal",
          "title": "Census"
        },
        {
          "field": "status",
          "type": "nominal",
          "title": "Status"
        }
      ]
    }
  }
}