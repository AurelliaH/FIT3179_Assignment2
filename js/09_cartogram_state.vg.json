{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 520,
  "height": 450,
  "data": {
    "url": "data/volunteer_state_2021.csv"
  },
  "transform": [
    {
      "calculate": "{\"NT\": 1.732, \"Qld\": 3.464, \"WA\": 0.866, \"SA\": 2.598, \"NSW\": 4.33, \"ACT\": 6.062, \"Vic\": 3.464, \"Tas\": 3.464, \"OT\": 0.0}[datum.state_abbr]",
      "as": "hx"
    },
    {
      "calculate": "{\"NT\": 0.0, \"Qld\": 0.0, \"WA\": 1.5, \"SA\": 1.5, \"NSW\": 1.5, \"ACT\": 1.5, \"Vic\": 3.0, \"Tas\": 4.5, \"OT\": 4.5}[datum.state_abbr]",
      "as": "hy"
    },
    {
      "calculate": "format(datum.rate_pop15plus,'.1f') + '%'",
      "as": "label"
    },
    {
      "calculate": "datum.state_abbr === 'OT' ? 'Other Territories' : datum.state",
      "as": "fullname"
    }
  ],
  "encoding": {
    "x": {
      "field": "hx",
      "type": "quantitative",
      "axis": null,
      "scale": {
        "domain": [
          -1.0,
          7.0
        ],
        "nice": false
      }
    },
    "y": {
      "field": "hy",
      "type": "quantitative",
      "axis": null,
      "scale": {
        "domain": [
          -1.12,
          5.72
        ],
        "nice": false,
        "reverse": true
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "point",
        "shape": "M0,-1 L0.866,-0.5 L0.866,0.5 L0,1 L-0.866,0.5 L-0.866,-0.5 Z",
        "filled": true,
        "size": 17500,
        "stroke": "#14383A",
        "strokeWidth": 3
      },
      "encoding": {
        "color": {
          "field": "rate_pop15plus",
          "type": "quantitative",
          "title": "% of people aged 15+",
          "scale": {
            "domain": [
              13,
              22
            ],
            "range": [
              "#1C7A70",
              "#4B9385",
              "#70AC9C",
              "#94C6B5",
              "#B7E0CF",
              "#DAFBEB"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "gradientLength": 230,
            "format": ".0f",
            "titleLimit": 320
          }
        },
        "tooltip": [
          {
            "field": "fullname",
            "type": "nominal",
            "title": "State or territory"
          },
          {
            "field": "rate_pop15plus",
            "type": "quantitative",
            "title": "% of people aged 15+",
            "format": ".1f"
          },
          {
            "field": "volunteers",
            "type": "quantitative",
            "title": "Volunteers",
            "format": ","
          },
          {
            "field": "population_15plus",
            "type": "quantitative",
            "title": "People aged 15+",
            "format": ","
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": -10,
        "fontSize": 17,
        "fontWeight": 700
      },
      "encoding": {
        "text": {
          "field": "state_abbr",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "datum.rate_pop15plus >= 17",
            "value": "#0E2A2B"
          },
          "value": "#DCEBE0"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": 12,
        "fontSize": 13,
        "fontWeight": 500
      },
      "encoding": {
        "text": {
          "field": "label",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "datum.rate_pop15plus >= 17",
            "value": "#1B4440"
          },
          "value": "#BBD3C4"
        }
      }
    }
  ]
}