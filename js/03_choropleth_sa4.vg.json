{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 460,
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "data/au_sa4_2021.topo.json",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#214D4C",
        "stroke": "#2E5C58",
        "strokeWidth": 0.6
      }
    },
    {
      "data": {
        "url": "data/au_sa4_2021.topo.json",
        "format": {
          "type": "topojson",
          "feature": "sa4"
        }
      },
      "transform": [
        {
          "lookup": "properties.sa4_code",
          "from": {
            "data": {
              "url": "data/volunteer_sa4_2021.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "sa4_code": "string"
                }
              }
            },
            "key": "sa4_code",
            "fields": [
              "sa4_name",
              "state_abbr",
              "region_type",
              "rate_pop15plus",
              "volunteers",
              "population_15plus"
            ]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#1A4244",
        "strokeWidth": 0.35
      },
      "encoding": {
        "color": {
          "field": "rate_pop15plus",
          "type": "quantitative",
          "title": "% of people aged 15+",
          "scale": {
            "type": "quantize",
            "nice": false,
            "domain": [
              6,
              24
            ],
            "range": [
              "#1C7A70",
              "#4B9385",
              "#70AC9C",
              "#94C6B5",
              "#B7E0CF",
              "#DAFBEB"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "gradientLength": 230,
            "format": ".0f",
            "titleLimit": 320
          }
        },
        "tooltip": [
          {
            "field": "sa4_name",
            "type": "nominal",
            "title": "Region"
          },
          {
            "field": "state_abbr",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "region_type",
            "type": "nominal",
            "title": "Type"
          },
          {
            "field": "rate_pop15plus",
            "type": "quantitative",
            "title": "% of people aged 15+",
            "format": ".1f"
          },
          {
            "field": "volunteers",
            "type": "quantitative",
            "title": "Volunteers",
            "format": ","
          },
          {
            "field": "population_15plus",
            "type": "quantitative",
            "title": "People aged 15+",
            "format": ","
          }
        ]
      }
    }
  ]
}