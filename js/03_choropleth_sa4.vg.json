{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 460,
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "data/au_sa4_2021.topo.json",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#2A6360",
        "stroke": "#2E5C58",
        "strokeWidth": 0.6
      }
    },
    {
      "data": {
        "url": "data/au_sa4_2021.topo.json",
        "format": {
          "type": "topojson",
          "feature": "sa4"
        }
      },
      "transform": [
        {
          "lookup": "properties.sa4_code",
          "from": {
            "data": {
              "url": "data/volunteer_sa4_2021.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "sa4_code": "string"
                }
              }
            },
            "key": "sa4_code",
            "fields": [
              "sa4_name",
              "state_abbr",
              "region_type",
              "rate_pop15plus",
              "volunteers",
              "population_15plus"
            ]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#1E5551",
        "strokeWidth": 0.35
      },
      "encoding": {
        "color": {
          "field": "rate_pop15plus",
          "type": "quantitative",
          "title": "% of people aged 15+",
          "scale": {
            "type": "quantize",
            "nice": false,
            "domain": [
              6,
              24
            ],
            "range": [
              "#2D8B80",
              "#55A193",
              "#78B7A7",
              "#99CDBC",
              "#B9E4D2",
              "#D9FBEA"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "gradientLength": 230,
            "format": ".0f",
            "titleLimit": 320
          }
        },
        "tooltip": [
          {
            "field": "sa4_name",
            "type": "nominal",
            "title": "Region"
          },
          {
            "field": "state_abbr",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "region_type",
            "type": "nominal",
            "title": "Type"
          },
          {
            "field": "rate_pop15plus",
            "type": "quantitative",
            "title": "% of people aged 15+",
            "format": ".1f"
          },
          {
            "field": "volunteers",
            "type": "quantitative",
            "title": "Volunteers",
            "format": ","
          },
          {
            "field": "population_15plus",
            "type": "quantitative",
            "title": "People aged 15+",
            "format": ","
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 117.92,
            "lat": -32.05
          }
        ]
      },
      "mark": {
        "type": "point",
        "shape": "circle",
        "size": 90,
        "filled": false,
        "stroke": "#0B2422",
        "strokeWidth": 2.1
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 117.92,
            "lat": -32.05,
            "t": "WA Wheat Belt|24.0%"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 11,
        "lineBreak": "|",
        "fontSize": 11.5,
        "lineHeight": 14,
        "fontWeight": 700,
        "color": "#0B2422"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "t",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 150.82,
            "lat": -33.93
          }
        ]
      },
      "mark": {
        "type": "point",
        "shape": "circle",
        "size": 90,
        "filled": false,
        "stroke": "#0B2422",
        "strokeWidth": 2.1
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 150.82,
            "lat": -33.93,
            "t": "Sydney – South West|6.3%"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "dx": -11,
        "lineBreak": "|",
        "fontSize": 11.5,
        "lineHeight": 14,
        "fontWeight": 700,
        "color": "#0B2422"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "t",
          "type": "nominal"
        }
      }
    }
  ]
}
